<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="#0D0D0D"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#2A2A2A"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/carouselImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="Foto da sessão de hidratação"
                android:scaleType="fitCenter"
                tools:srcCompat="@android:drawable/ic_menu_camera" />

            <!-- Indicador de Tag de Evento no topo da imagem -->
            <TextView
                android:id="@+id/carouselBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="10dp"
                android:background="@drawable/bg_badge_drinking"
                android:drawablePadding="6dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_water_drop"
                tools:text="Hidratação Confirmada" />

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
