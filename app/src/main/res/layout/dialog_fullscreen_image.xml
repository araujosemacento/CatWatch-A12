<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="#1A1A1A"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:strokeColor="#333333"
    app:strokeWidth="1dp">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Barra Superior do Diálogo -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/dialogCloseButton"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/dialogTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sessão de Hidratação"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dialogSessionCounter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#81C784"
                        android:textSize="12sp"
                        tools:text="Foto 1 de 2 • Deslize para ver a sequência" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/dialogCloseButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Fechar"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#CCCCCC" />
            </RelativeLayout>

            <!-- Carrossel ViewPager2 da Sessão -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/sessionViewPager"
                android:layout_width="match_parent"
                android:layout_height="280dp" />

            <!-- Indicador Dinâmico de Pontos -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayoutIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                app:tabBackground="@drawable/bg_tab_indicator"
                app:tabGravity="center"
                app:tabIndicatorHeight="0dp"
                app:tabMaxWidth="16dp"
                app:tabPaddingEnd="8dp"
                app:tabPaddingStart="8dp" />

            <!-- Metadados do Registro Atual Selecionado -->
            <TextView
                android:id="@+id/dialogTimestamp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                tools:text="Data/Hora: 05/10/2026 às 01:15:30" />

            <TextView
                android:id="@+id/dialogConfidence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#81C784"
                android:textSize="14sp"
                tools:text="Confiança: 94.5%" />

            <TextView
                android:id="@+id/dialogFilePath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="middle"
                android:maxLines="2"
                android:textColor="#888888"
                android:textSize="12sp"
                tools:text="Arquivo: /storage/emulated/0/Pictures/CatWatch/CAT_DRINKING_...jpg" />

            <!-- Botão de Excluir Foto da Sessão -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialogDeleteButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Excluir Foto"
                android:textColor="#FF5252"
                app:backgroundTint="#2C1B1B"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconTint="#FF5252"
                app:strokeColor="#FF5252"
                app:strokeWidth="1dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.google.android.material.card.MaterialCardView>
