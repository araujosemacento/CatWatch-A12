<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="#1A1A1A"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:strokeColor="#333333"
    app:strokeWidth="1dp">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Barra Superior do Diálogo -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/dialogTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/dialogCloseButton"
                    android:layout_marginEnd="8dp"
                    android:text="Detalhes do Registro"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/dialogCloseButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Fechar"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#CCCCCC" />
            </RelativeLayout>

            <!-- Imagem em Alta Resolução -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="280dp"
                app:cardBackgroundColor="#0D0D0D"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#2A2A2A"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/dialogFullImageView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:contentDescription="Registro em tamanho real"
                    android:scaleType="fitCenter"
                    tools:srcCompat="@android:drawable/ic_menu_camera" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Status Badge sem emojis -->
            <TextView
                android:id="@+id/dialogStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_badge_drinking"
                android:drawablePadding="6dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_water_drop"
                tools:text="Hidratação Confirmada" />

            <!-- Metadados -->
            <TextView
                android:id="@+id/dialogTimestamp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                tools:text="Data/Hora: 05/10/2026 às 01:15:30" />

            <TextView
                android:id="@+id/dialogConfidence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#81C784"
                android:textSize="14sp"
                tools:text="Confiança: 94.5%" />

            <TextView
                android:id="@+id/dialogFilePath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="middle"
                android:maxLines="3"
                android:textColor="#888888"
                android:textSize="12sp"
                tools:text="Arquivo: /storage/emulated/0/Pictures/CatWatch/CAT_DRINKING_...jpg" />

            <!-- Botão de Excluir Foto Individual -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialogDeleteButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Excluir Registro"
                android:textColor="#FF5252"
                app:backgroundTint="#2C1B1B"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconTint="#FF5252"
                app:strokeColor="#FF5252"
                app:strokeWidth="1dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.google.android.material.card.MaterialCardView>
