<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Metade Superior: Preview da Câmera -->
    <!-- Metade Superior: Preview da Câmera (estático em 45% para zero recomposição de GPU) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:implementationMode="compatible"
        app:layout_constraintBottom_toTopOf="@id/cameraGuideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Overlay Câmera Desligada -->
    <LinearLayout
        android:id="@+id/cameraOffOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#A0000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/cameraGuideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_videocam_off"
            app:tint="#CCCCCC" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Câmera em repouso"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Guideline 45% para limite do preview em repouso -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/cameraGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.45" />

    <!-- Guideline 20% para ancoragem do topo do painel deslizante em expansão máxima -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.20" />

    <!-- Painel de Controle e Feed (Repouso em 45% -> Expansão até 80% via translationY com zero-jank) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/feedPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#121212"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guideline">

        <!-- Contêiner Unificado de Toolbars: Evita sobreposição com os chips de filtro -->
        <FrameLayout
            android:id="@+id/toolbarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Barra Normal de Título do Feed e Controles Operacionais -->
            <LinearLayout
                android:id="@+id/normalToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="6dp">

                <!-- Linha 1: Título do Feed e Ação de Seleção -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/feedTitleTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@+id/selectModeButton"
                        android:layout_marginEnd="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Detecções"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/selectModeButton"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Selecionar"
                        android:textColor="#81C784"
                        android:textSize="13sp"
                        app:icon="@android:drawable/ic_menu_agenda"
                        app:iconTint="#81C784" />
                </RelativeLayout>

                <!-- Linha 2: Seletor Operacional em 3 Estados (Segmented Button) -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/cameraModeToggleGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeOff"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Desligado"
                        android:textColor="@color/selector_toggle_text"
                        android:textSize="11sp"
                        app:iconGravity="textStart"
                        app:icon="@drawable/ic_videocam_off"
                        app:iconPadding="6dp"
                        app:iconSize="14dp"
                        app:iconTint="@color/selector_toggle_text"
                        app:strokeColor="#333333" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeFrame"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Enquadrar"
                        android:textColor="@color/selector_toggle_text"
                        android:textSize="11sp"
                        app:iconGravity="textStart"
                        app:icon="@drawable/ic_crop_free"
                        app:iconPadding="6dp"
                        app:iconSize="14dp"
                        app:iconTint="@color/selector_toggle_text"
                        app:strokeColor="#333333" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeMonitor"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Monitorar"
                        android:textColor="@color/selector_toggle_text"
                        android:textSize="11sp"
                        app:iconGravity="textStart"
                        app:icon="@drawable/ic_visibility"
                        app:iconPadding="6dp"
                        app:iconSize="14dp"
                        app:iconTint="@color/selector_toggle_text"
                        app:strokeColor="#333333" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>

            <!-- Barra Contextual de Seleção em Lote (Action Mode) -->
            <RelativeLayout
                android:id="@+id/selectionToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1E1E1E"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/selectionCountTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/selectionActionsLayout"
                    android:layout_marginEnd="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="0 selecionados"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/selectionActionsLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/selectAllButton"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Todos"
                        android:textColor="#90CAF9"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/deleteSelectedButton"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Excluir"
                        android:textColor="#FF5252"
                        android:textSize="12sp"
                        app:icon="@android:drawable/ic_menu_delete"
                        app:iconPadding="4dp"
                        app:iconTint="#FF5252" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cancelSelectionButton"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Cancelar"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp" />
                </LinearLayout>
            </RelativeLayout>
        </FrameLayout>

        <!-- Barra de Filtros Temporais (Chips): Ancorada ao contêiner unificado de toolbar -->
        <HorizontalScrollView
            android:id="@+id/filterScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/toolbarContainer">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/filterChipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Todos"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="#2C2C2C" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipToday"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hoje"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="#2C2C2C" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip24h"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Últimas 24h"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="#2C2C2C" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipYesterday"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ontem"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="#2C2C2C" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCustomRange"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Intervalo"
                    android:textColor="@color/white"
                    app:chipIcon="@drawable/ic_calendar"
                    app:chipIconTint="@color/white"
                    app:chipBackgroundColor="#2C2C2C" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Feed Cronológico de Eventos -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/eventsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/filterScrollView"
            tools:listitem="@layout/item_cat_event" />

        <!-- Estado Vazio -->
        <TextView
            android:id="@+id/emptyStateTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nenhum evento registrado no período."
            android:textColor="#666666"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/eventsRecyclerView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/eventsRecyclerView" />

        <!-- Botão Flutuante com Badge de Notificação -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/fabContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabScrollToTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_chevron_up"
                app:backgroundTint="#2E7D32"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white" />

            <View
                android:id="@+id/fabNewItemsBadge"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_red_dot"
                android:elevation="8dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/fabScrollToTop"
                app:layout_constraintTop_toTopOf="@id/fabScrollToTop"
                tools:visibility="visible" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
